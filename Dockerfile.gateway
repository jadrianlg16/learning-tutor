# learn-gateway — gateway + llm + tutor + corpus modules in one process (extraction rule).
FROM python:3.11-slim AS base
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy
COPY --from=ghcr.io/astral-sh/uv:0.8 /uv /uvx /bin/
WORKDIR /app
COPY pyproject.toml uv.lock ./
RUN --mount=type=cache,target=/root/.cache/uv uv sync --frozen --no-dev --no-install-project
COPY learning_tutor ./learning_tutor
COPY skills ./skills
RUN --mount=type=cache,target=/root/.cache/uv uv sync --frozen --no-dev
ENV PATH="/app/.venv/bin:$PATH" LT_DATA_DIR=/data GATEWAY_HOST=0.0.0.0 GATEWAY_PORT=5033 \
    LT_PROMPT_PACK_DIR=/app/skills/teach/prompts
EXPOSE 5033
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s CMD python -c "import urllib.request,os;urllib.request.urlopen('http://127.0.0.1:%s/api/health'%os.environ.get('GATEWAY_PORT','5033'))" || exit 1
CMD ["learn-gateway"]
