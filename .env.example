# Copy to .env. Every value has a default; nothing here is machine-specific.
# --- ports on the host ---
# the only published port (web UI + /api)
GATEWAY_PORT=5033
# host address the port is published on; 0.0.0.0 exposes it to other machines (no auth)
GATEWAY_BIND=127.0.0.1
# --- LLM ---
# ollama | claude | openai | google | lm_studio | custom
# with claude, set LT_LLM_MODEL=claude-opus-5-5 and keep a different solver model
LT_LLM_PROVIDER=ollama
LT_LLM_MODEL=llama3.1:8b
OLLAMA_URL=http://host.docker.internal:11434
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
# blind solver must differ from the tutor (same model never author + solver + judge)
LT_LLM_SOLVER_PROVIDER=ollama
LT_LLM_SOLVER_MODEL=gemma3:12b
LT_LLM_ALLOW_SAME_SOLVER=0
# per provider call; a local 12B on a plan prompt exceeds 60
LT_LLM_TIMEOUT_S=120
# --- planning ---
# under this, the plan is retried once, then returned with a warning
LT_PLAN_MIN_NODES=6
# --- corpus ---
# or `hash` for an offline deterministic fallback
LT_EMBED_MODEL=nomic-embed-text
# optional: any compatible transcription service for lecture audio (POST /transcribe)
LT_TRANSCRIBE_URL=
# optional: YouTube transcript service
LT_YT_TRANSCRIPTS_URL=
# optional: OCR for scanned PDFs
LT_OCR_URL=
# --- storage ---
# bind-mounted to /data in learner-svc and gateway
LT_DATA_DIR_HOST=./data
# optional: Obsidian vault on the host, mounted at /vault
VAULT_DIR=
# --- optional Telegram reminders (any scheduler runs telegram/job.py on the host; not in compose) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
